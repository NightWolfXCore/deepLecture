# Additional --env-file; copy to a new ignored .env.llm, never overwrite a real file.
# Generic OpenAI-compatible HTTPS endpoint. A key and provider model are required.
# Groq/OpenRouter quotas and model availability have NOT been verified.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_AUTH_MODE=bearer
LLM_ALLOW_HTTP=false
LLM_TIMEOUT=90
