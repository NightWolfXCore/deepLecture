# Use together with infra/compose.ollama.yml; no cloud API budget required.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=Qwen3-4B-Q4_K_M
LLM_API_KEY=
LLM_AUTH_MODE=none
# Disable thinking for bounded JSON summaries; requires a recent Ollama.
LLM_REASONING_EFFORT=none
LLM_ALLOW_HTTP=true
LLM_TIMEOUT=300
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_IMAGE=ollama/ollama:0.40.12
