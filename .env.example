# Copy to .env. These are local development settings, not real credentials.
DB_NAME=deeplecture
DB_USER=deeplecture
DB_PASSWORD=replace-with-a-local-password
HTTP_PORT=8080
CPU_THREADS=2
MAX_IMPORT_BYTES=524288000
IMPORT_TIMEOUT=1800
MODELS_OFFLINE=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pin immutable Hugging Face commit revisions after a verified download.
EMBEDDING_REVISION=
WHISPER_MODEL=small
WHISPER_REVISION=
# OpenAI-compatible HTTPS API. Never commit a real key.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_AUTH_MODE=bearer
LLM_REASONING_EFFORT=
LLM_ALLOW_HTTP=false
LLM_TIMEOUT=90
