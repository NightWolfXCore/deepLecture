# Created automatically by the default Compose init-env service when absent.
DB_NAME=deeplecture
DB_USER=root
DB_PASSWORD=
HTTP_PORT=8080
CPU_THREADS=2
MAX_IMPORT_BYTES=524288000
IMPORT_TIMEOUT=1800
MODELS_OFFLINE=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pin immutable Hugging Face commit revisions after a verified download.
EMBEDDING_REVISION=
WHISPER_MODEL=small
WHISPER_REVISION=
# Local Qwen3 4B GGUF through the default compose.yaml. No API key required.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=deeplecture-qwen3:4b
LLM_API_KEY=
LLM_AUTH_MODE=none
LLM_REASONING_EFFORT=none
LLM_ALLOW_HTTP=true
LLM_TIMEOUT=300
